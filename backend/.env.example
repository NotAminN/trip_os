# ===== Core =====
SECRET_KEY=change-me-in-production
DEBUG=False

# Comma-separated hosts the server is reachable at, e.g. your domain/IP.
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ===== Database (PostgreSQL) =====
# Production requires a real PostgreSQL database.
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# ===== CORS / CSRF =====
# Your frontend origin(s), comma-separated. No localhost defaults.
# On Vercel this is e.g. https://trip-os-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# ===== Static / Media =====
# WhiteNoise serves static assets automatically (no config needed).
# Optional: serve MEDIA through Django in production (NOT recommended on
# serverless hosts such as Vercel — uploads are ephemeral; use an object
# storage/CDN instead).
SERVE_MEDIA_IN_PROD=False

# ===== Security (production hardening) =====
SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ===== Misc =====
TIME_ZONE=Asia/Tehran

# ===== JWT =====
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
